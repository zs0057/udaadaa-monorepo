DB_URL=jdbc:postgresql://localhost:5432/udaadaa
DB_USERNAME=udaadaa
DB_PASSWORD=replace-with-local-password
DB_MIGRATION_ENABLED=false
DB_MIGRATION_BASELINE_ON_MIGRATE=false
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=3000

SUPABASE_JWT_MODE=hmac
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=replace-with-legacy-jwt-secret
SUPABASE_JWT_JWK_SET_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
